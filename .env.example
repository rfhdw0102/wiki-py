WIKI_AGENT_ENV=development
WIKI_AGENT_SECRET_KEY=replace-with-at-least-32-random-characters
WIKI_AGENT_ENCRYPTION_KEY=
WIKI_AGENT_DATABASE_URL=postgresql+psycopg://wiki:wiki@postgres:5432/wiki
WIKI_AGENT_REDIS_URL=redis://redis:6379/0
WIKI_AGENT_KNOWLEDGE_ROOT=/app/knowledge
WIKI_AGENT_STORAGE_ROOT=/app/storage
WIKI_AGENT_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WIKI_AGENT_AUTO_CREATE_SCHEMA=true
WIKI_AGENT_COMPILATION_MODEL_TIMEOUT_SECONDS=180
# Docker Compose configures the internal browser URL automatically.
# WIKI_AGENT_BROWSER_SERVICE_URL=http://browser:8080
# QQ 邮箱须开启 SMTP 服务；这里填写独立授权码，不是 QQ 登录密码。
WIKI_AGENT_SMTP_HOST=smtp.qq.com
WIKI_AGENT_SMTP_PORT=465
WIKI_AGENT_SMTP_USERNAME=your-account@qq.com
WIKI_AGENT_SMTP_AUTH_CODE=replace-with-qq-smtp-auth-code
WIKI_AGENT_SMTP_USE_TLS=true
WIKI_AGENT_EMAIL_FROM_NAME=智库 Wiki
WIKI_AGENT_EMAIL_CODE_TTL_SECONDS=600
WIKI_AGENT_EMAIL_CODE_COOLDOWN_SECONDS=60
WIKI_AGENT_INITIAL_ADMIN_USERNAME=admin
WIKI_AGENT_INITIAL_ADMIN_PASSWORD=WikiAdmin123!
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
