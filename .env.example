WIKI_AGENT_ENV=development
WIKI_AGENT_SECRET_KEY=replace-with-at-least-32-random-characters
WIKI_AGENT_ENCRYPTION_KEY=
WIKI_AGENT_DATABASE_URL=postgresql+psycopg://wiki:wiki@postgres:5432/wiki
WIKI_AGENT_REDIS_URL=redis://redis:6379/0
WIKI_AGENT_KNOWLEDGE_ROOT=/app/knowledge
WIKI_AGENT_STORAGE_ROOT=/app/storage
WIKI_AGENT_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WIKI_AGENT_AUTO_CREATE_SCHEMA=true
WIKI_AGENT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WIKI_AGENT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
